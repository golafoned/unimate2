@model UniMate2.Models.DTO.EventDto
@{
    ViewData["Title"] = "Create Event";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Create Event</h1>

    <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
        <form asp-action="Create" method="post">
            <div class="mb-4">
                <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                <input asp-for="Title" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2" />
                <span asp-validation-for="Title" class="text-red-600 text-sm mt-1"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea asp-for="Description" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-red-600 text-sm mt-1"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="StartDate" class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                    <input asp-for="StartDate" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2" type="datetime-local" />
                    <span asp-validation-for="StartDate" class="text-red-600 text-sm mt-1"></span>
                </div>

                <div>
                    <label asp-for="EndDate" class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                    <input asp-for="EndDate" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2" type="datetime-local" />
                    <span asp-validation-for="EndDate" class="text-red-600 text-sm mt-1"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Location" class="block text-sm font-medium text-gray-700 mb-1">Location</label>
                <input asp-for="Location" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2" />
                <span asp-validation-for="Location" class="text-red-600 text-sm mt-1"></span>
            </div>

            <div class="mt-6 flex items-center justify-end space-x-3">
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Cancel</a>
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
