@model IEnumerable<UniMate2.Models.Domain.Event>
@{
    ViewData["Title"] = "Events";
    // Determine the current sort order from the query string, defaulting to ascending
    var currentOrder = Context.Request.Query["order"].ToString();
    if (string.IsNullOrEmpty(currentOrder))
    {
        currentOrder = "asc";
    }
    // Toggle the order for our button
    var toggleOrder = currentOrder.Equals("asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Events</h1>

    <div class="flex flex-col md:flex-row justify-between items-center mb-6 space-y-4 md:space-y-0">
        <div class="w-full md:w-1/2">
            <form method="get" action="@Url.Action("Index", "Events")" class="flex">
                <input type="hidden" name="order" value="@currentOrder" />
                <input type="text" name="searchTerm" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 mr-2" placeholder="Search events..." value="@searchTerm" />
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Search</button>
            </form>
        </div>
        <div class="w-full md:w-auto flex items-center justify-end space-x-3">
            <a class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" href="@Url.Action("Index", "Events", new { order = toggleOrder, searchTerm })">
                Order: @toggleOrder.ToUpperInvariant()
            </a>
            <a class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" href="@Url.Action("Create", "Events")">Add Event</a>
        </div>
    </div>

    <div class="bg-white shadow-sm rounded-lg overflow-hidden border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-100 border-b border-gray-300">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Title</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Description</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Start Date</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">End Date</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Location</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model != null && Model.Any())
                {
                    foreach (var evt in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@evt.Title</td>
                            <td class="px-6 py-4 whitespace-normal text-sm text-gray-600">@evt.Description</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@evt.StartDate.ToString("g")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@evt.EndDate.ToString("g")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@evt.Location</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <form asp-action="Delete" asp-route-id="@evt.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');" class="inline-block mr-2">
                                    <button type="submit" class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded-lg text-red-700 bg-red-100 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">Delete</button>
                                </form>
                                <!-- Add Edit link/button here if needed -->
                                <!-- <a href="@Url.Action("Edit", "Events", new { id = evt.Id })" class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded text-blue-700 bg-blue-100 hover:bg-blue-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Edit</a> -->
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">No events available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @{
        var currentPage = (int)ViewBag.CurrentPage;
        var totalPages = (int)ViewBag.TotalPages;
        var hasPreviousPage = (bool)ViewBag.HasPreviousPage;
        var hasNextPage = (bool)ViewBag.HasNextPage;
        // currentOrder та searchTerm вже визначені на початку файлу
    }

    @if (totalPages > 1)
    {
        <div class="mt-6 flex justify-center items-center space-x-1 sm:space-x-2">
            @if (hasPreviousPage)
            {
                <a href="@Url.Action("Index", "Events", new { page = currentPage - 1, order = currentOrder, searchTerm = searchTerm })"
                   class="px-3 py-2 sm:px-4 border border-gray-300 text-xs sm:text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                    Previous
                </a>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                // Логіка для відображення обмеженої кількості номерів сторінок
                var pageNumberVisible = (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2));
                var showEllipsis = (i == currentPage - 3 && currentPage > 4) || (i == currentPage + 3 && currentPage < totalPages - 3);

                if (showEllipsis)
                {
                    <span class="px-3 py-2 sm:px-4 border border-transparent text-xs sm:text-sm font-medium rounded-md text-gray-700">...</span>
                }
                
                if (pageNumberVisible)
                {
                    <a href="@Url.Action("Index", "Events", new { page = i, order = currentOrder, searchTerm = searchTerm })"
                       class="px-3 py-2 sm:px-4 border @(i == currentPage ? "border-blue-500 bg-blue-50 text-blue-600" : "border-gray-300 text-gray-700 bg-white hover:bg-gray-50") text-xs sm:text-sm font-medium rounded-md">
                        @i
                    </a>
                }
            }

            @if (hasNextPage)
            {
                <a href="@Url.Action("Index", "Events", new { page = currentPage + 1, order = currentOrder, searchTerm = searchTerm })"
                   class="px-3 py-2 sm:px-4 border border-gray-300 text-xs sm:text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                    Next
                </a>
            }
        </div>
    }
</div>