@model List<UniMate2.Models.Domain.Like>
@{
    ViewData["Title"] = "Manage Likes";
}

<div class="container mt-4">
    <h1>Manage Likes</h1>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <ul>
                <li>@TempData["ErrorMessage"]</li>
            </ul>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Liker</th>
                            <th>Liked User</th>
                            <th>Liked At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var like in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("ViewProfile", "Users", new { id = like.LikerId })">
                                        @like.Liker.FirstName @like.Liker.LastName
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("ViewProfile", "Users", new { id = like.LikedId })">
                                        @like.Liked.FirstName @like.Liked.LastName
                                    </a>
                                </td>
                                <td>@like.LikedAt.ToString("g")</td>
                                <td>
                                    <form asp-action="DeleteLike" method="post" style="display: inline-block;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="likeId" value="@like.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" 
                                                onclick="return confirm('Are you sure you want to delete this like?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <p class="text-center text-muted">No likes found in the system.</p>
            }
        </div>
    </div>
    
    <div class="mb-3">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
