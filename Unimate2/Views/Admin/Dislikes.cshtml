@model List<UniMate2.Models.Domain.UserDislike>
@{
    ViewData["Title"] = "Manage Dislikes";
}

<div class="container mx-auto mt-6 px-4">
    <h1 class="text-3xl font-semibold text-gray-800 mb-6">Manage Dislikes</h1>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 text-green-700 p-4 mb-4 rounded-md">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 text-red-700 p-4 mb-4 rounded-md">
            <ul>
                <li>@TempData["ErrorMessage"]</li>
            </ul>
        </div>
    }

    <!-- Table Container -->
    <div class="bg-white shadow-md rounded-lg p-6">
        <div class="overflow-x-auto">
            <table class="min-w-full table-auto">
                <thead>
                    <tr class="bg-gray-100 text-gray-600">
                        <th class="px-6 py-3 text-left">Disliking User</th>
                        <th class="px-6 py-3 text-left">Disliked User</th>
                        <th class="px-6 py-3 text-left">Created At</th>
                        <th class="px-6 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dislike in Model)
                    {
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <a href="@Url.Action("ViewProfile", "Users", new { id = dislike.DislikingUserId })" class="text-blue-600 hover:underline">
                                    @dislike.DislikingUser.FirstName @dislike.DislikingUser.LastName
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                <a href="@Url.Action("ViewProfile", "Users", new { id = dislike.DislikedUserId })" class="text-blue-600 hover:underline">
                                    @dislike.DislikedUser.FirstName @dislike.DislikedUser.LastName
                                </a>
                            </td>
                            <td class="px-6 py-4">@dislike.CreatedAt.ToString("g")</td>
                            <td class="px-6 py-4">
                                <form asp-action="DeleteDislike" method="post" class="inline-block">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="dislikeId" value="@dislike.Id" />
                                    <button type="submit" class="bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition duration-200"
                                            onclick="return confirm('Are you sure you want to delete this dislike?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- No Dislikes Found -->
        @if (!Model.Any())
        {
            <p class="text-center text-gray-500">No dislikes found in the system.</p>
        }
    </div>

    <!-- Back to Dashboard Button -->
    <div class="mt-6">
        <a asp-action="Dashboard" class="bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300 transition duration-200">Back to Dashboard</a>
    </div>
</div>
