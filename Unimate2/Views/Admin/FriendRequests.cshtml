@model List<UniMate2.Models.Domain.FriendRequest>
@using UniMate2.Models.Domain.Enums
@{
    ViewData["Title"] = "Manage Friend Requests";
}

<div class="container mx-auto max-w-7xl mt-8 px-4">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Manage Friend Requests</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded-md mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-md mb-4">
            <ul class="list-disc list-inside">
                <li>@TempData["ErrorMessage"]</li>
            </ul>
        </div>
    }

    <div class="bg-white rounded-xl shadow-md border border-gray-100 mb-6">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-gray-600">
                <thead class="bg-gray-50 text-gray-700 uppercase text-xs">
                    <tr>
                        <th class="px-6 py-4 text-left">Sender</th>
                        <th class="px-6 py-4 text-left">Receiver</th>
                        <th class="px-6 py-4 text-left">Status</th>
                        <th class="px-6 py-4 text-left">Request Date</th>
                        <th class="px-6 py-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var request in Model)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <a href="@Url.Action("ViewProfile", "Users", new { id = request.Sender.Id })"
                                   class="text-blue-600 hover:underline font-semibold">
                                    @request.Sender.FirstName @request.Sender.LastName
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                <a href="@Url.Action("ViewProfile", "Users", new { id = request.Receiver.Id })"
                                   class="text-blue-600 hover:underline font-semibold">
                                    @request.Receiver.FirstName @request.Receiver.LastName
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                @if (request.Status == FriendRequestStatus.Pending)
                                {
                                    <span class="inline-block bg-yellow-100 text-yellow-800 text-xs font-semibold px-3 py-1 rounded-full">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == FriendRequestStatus.Accepted)
                                {
                                    <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-3 py-1 rounded-full">
                                        Accepted
                                    </span>
                                }
                                else if (request.Status == FriendRequestStatus.Declined)
                                {
                                    <span class="inline-block bg-red-100 text-red-800 text-xs font-semibold px-3 py-1 rounded-full">
                                        Declined
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">@request.RequestDate.ToString("g")</td>
                            <td class="px-6 py-4 space-x-2">
                                @if (request.Status == FriendRequestStatus.Pending)
                                {
                                    <form asp-action="UpdateFriendRequestStatus" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="status" value="accept" />
                                        <button type="submit"
                                                class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded-lg text-green-700 bg-green-100 hover:bg-green-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                                            Accept
                                        </button>

                                    </form>
                                    <form asp-action="UpdateFriendRequestStatus" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="status" value="decline" />
                                        <button type="submit"
                                                class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded-lg text-yellow-700 bg-yellow-100 hover:bg-yellow-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500">
                                            Decline
                                        </button>

                                    </form>
                                }
                                <form asp-action="UpdateFriendRequestStatus" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <input type="hidden" name="status" value="delete" />
                                    <button type="submit"
                                            class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded-lg text-red-700 bg-red-100 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
                                            onclick="return confirm('Are you sure you want to delete this friend request?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-gray-500 py-6">No friend requests found in the system.</p>
        }
    </div>

    <div>
        <a asp-action="Dashboard"
           class="inline-block bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-lg hover:bg-gray-300 transition duration-200 shadow-sm">
            Back to Dashboard
        </a>
    </div>
</div>
