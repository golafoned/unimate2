@model UniMate2.Models.Domain.Event
@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mx-auto mt-6 px-4">
    <h1 class="text-3xl font-semibold text-gray-800 mb-6">Edit Event</h1>

    <!-- Success and Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 text-green-700 p-4 mb-4 rounded-md">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 text-red-700 p-4 mb-4 rounded-md">
            <ul>
                <li>@TempData["ErrorMessage"]</li>
            </ul>
        </div>
    }

    <!-- Event Form -->
    <form asp-action="UpdateEvent" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="bg-white shadow-md rounded-lg p-6 mb-4">
            <!-- Title -->
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2">Title</label>
                <input type="text" class="form-input w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" name="Title" value="@Model.Title" required />
            </div>

            <!-- Description -->
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2">Description</label>
                <textarea class="form-input w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" name="Description" rows="4">@Model.Description</textarea>
            </div>

            <!-- Location -->
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2">Location</label>
                <input type="text" class="form-input w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" name="Location" value="@Model.Location" required />
            </div>

            <!-- Start and End Date -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="mb-4">
                    <label class="block text-gray-700 font-semibold mb-2">Start Date</label>
                    <input type="datetime-local" class="form-input w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-semibold mb-2">End Date</label>
                    <input type="datetime-local" class="form-input w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between items-center mb-4">
            <button type="submit" class="bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition duration-200">Update Event</button>
            <a asp-action="Events" class="bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300 transition duration-200">Back to List</a>

            <!-- Delete Event Form -->
            <form asp-action="DeleteEvent" method="post" class="inline-block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit" class="bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition duration-200"
                        onclick="return confirm('Are you sure you want to delete this event? This action cannot be undone.');">
                    Delete Event
                </button>
            </form>
        </div>
    </form>
</div>
