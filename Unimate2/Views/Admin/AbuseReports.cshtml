@{
    ViewData["Title"] = "Abuse Reports";
}

<div class="container mx-auto mt-6 px-4">
    <h1 class="text-3xl font-semibold text-gray-800 mb-4">Abuse Reports</h1>

    <!-- Table for Abuse Reports -->
    <table class="min-w-full bg-white border border-gray-200 shadow-md rounded-lg">
        <thead>
            <tr class="bg-gray-100 text-gray-600">
                <th class="px-6 py-3 border-b">Reported User</th>
                <th class="px-6 py-3 border-b">Reason</th>
                <th class="px-6 py-3 border-b">Date</th>
                <th class="px-6 py-3 border-b">Actions</th>
            </tr>
        </thead>
        <tbody>
            <!-- Iterate over each report directly from the model -->
            @foreach (var report in Model)
            {
                <tr class="border-b hover:bg-gray-50">
                    <td class="px-6 py-4">
                        @if (report.ReportedUser != null)
                        {
                            @report.ReportedUser.UserName
                        }
                        else
                        {
                            @report.ReportedUserId
                        }
                    </td>
                    <td class="px-6 py-4">@report.Reason</td>
                    <td class="px-6 py-4">@report.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="px-6 py-4 flex space-x-2">
                        <!-- Delete Abuse Report Button -->
                        <form asp-action="DeleteAbuseReport" method="post" class="inline-block">
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="bg-red-600 text-white py-1 px-4 rounded-lg hover:bg-red-700 transition duration-200">Delete Report</button>
                        </form>
                        <!-- Ban User Button -->
                        <form asp-action="BanUser" method="post" class="inline-block ml-2">
                            <input type="hidden" name="userId" value="@report.ReportedUserId" />
                            <button type="submit" class="bg-yellow-600 text-white py-1 px-4 rounded-lg hover:bg-yellow-700 transition duration-200">Ban User</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
