@model UniMate2.Models.ViewModels.UserSuggestionsViewModel
@{
    ViewData["Title"] = "User Suggestions";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Search Form -->
    <div class="max-w-xl mx-auto mb-8">
        <form asp-controller="Friends" asp-action="Suggestions" method="get" class="flex items-center space-x-2">
            <input type="text" name="searchTerm" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2 px-3 text-sm" placeholder="Search by name or email" value="@Model.SearchTerm">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 shadow-sm text-sm flex-shrink-0">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                    <a asp-controller="Friends" asp-action="Suggestions" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-lg transition duration-200 shadow-sm border border-gray-300 text-sm flex-shrink-0">Clear</a>
            }
        </form>
    </div>

    <h2 class="text-2xl font-semibold text-gray-800 mb-6">People You May Know</h2>

    @if (Model.Suggestions.Any())
    {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var user in Model.Suggestions)
            {
                        <div class="bg-white rounded-lg shadow-md border border-gray-100 overflow-hidden flex flex-col">
                            <div class="p-6 flex flex-col items-center flex-grow">
                                <div class="mb-4">
                            @if (!string.IsNullOrEmpty(user.ProfilePicture) || !string.IsNullOrEmpty(user.ProfileImagePath))
                            {
                                            <img src="@(string.IsNullOrEmpty(user.ProfilePicture) ? user.ProfileImagePath : user.ProfilePicture)" 
                                                 alt="Profile Picture" 
                                                 class="rounded-full w-24 h-24 object-cover border-2 border-gray-200 shadow-sm">
                            }
                            else
                            {
                                            <!-- Default SVG User Icon -->
                                            <div class="rounded-full bg-gray-200 w-24 h-24 flex items-center justify-center border-2 border-gray-200 shadow-sm">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                            </div>
                            }
                                </div>
                                <h5 class="text-lg font-semibold text-gray-800 truncate">@user.FirstName @user.LastName</h5>
                                <p class="text-sm text-gray-500 mb-4 truncate">@user.Email</p>

                                <div class="flex space-x-2 w-full mt-auto">
                                    <a asp-controller="Users" asp-action="ViewProfile" asp-route-id="@user.Id" class="flex-1 inline-flex items-center justify-center bg-white hover:bg-gray-50 text-gray-700 font-semibold py-2 px-4 rounded-lg transition duration-200 shadow-sm border border-gray-300 text-sm">
                                        <!-- Optional: SVG icon -->
                                        View Profile
                                    </a>
                                    <form asp-controller="Friends" asp-action="SendRequest" method="post" class="flex-1">
                                        <input type="hidden" name="ReceiverEmail" value="@user.Email" />
                                        <button type="submit" class="w-full inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 shadow-sm text-sm">
                                            <!-- Optional: SVG icon -->
                                            Add Friend
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
            }
            </div>
    }
    else
    {
            <div class="bg-blue-50 text-blue-700 p-4 rounded-lg text-sm">
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                        <p>No users found matching your search. Try a different search term or <a asp-action="Suggestions" class="font-semibold underline hover:text-blue-800">clear the search</a>.</p>
            }
            else
            {
                        <p>No user suggestions available at the moment.</p>
            }
            </div>
    }
</div>
