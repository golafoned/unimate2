@model UniMate2.Models.ViewModels.FriendRequestsViewModel
@{
    ViewData["Title"] = "Friend Requests";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-6">Friend Requests</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Received Requests Column -->
        <div>
            <h3 class="text-xl font-semibold text-gray-700 mb-4">Received Requests</h3>
            @if (Model.ReceivedRequests.Any())
            {
                    <div class="space-y-4">
                    @foreach (var request in Model.ReceivedRequests)
                    {
                                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                                    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                                        <div class="flex items-center flex-grow">
                                    @if (!string.IsNullOrEmpty(request.Sender.ProfilePicture))
                                    {
                                                    <img src="@request.Sender.ProfilePicture" alt="Profile Picture" class="rounded-full w-10 h-10 object-cover mr-3 flex-shrink-0">
                                    }
                                    else
                                    {
                                                    <!-- Default SVG User Icon -->
                                                    <div class="rounded-full bg-gray-200 w-10 h-10 flex items-center justify-center mr-3 flex-shrink-0">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                        </svg>
                                                    </div>
                                    }
                                            <div class="overflow-hidden">
                                                <h5 class="text-base font-semibold text-gray-800 truncate">@request.Sender.FirstName @request.Sender.LastName</h5>
                                                <small class="text-sm text-gray-500 truncate block">@request.Sender.Email</small>
                                            </div>
                                        </div>
                                        <div class="flex space-x-2 flex-shrink-0 mt-2 sm:mt-0">
                                            <form asp-controller="Friends" asp-action="UpdateRequestStatus" method="post" class="inline">
                                                <input type="hidden" name="requestId" value="@request.Id" />
                                                <input type="hidden" name="action" value="accept" />
                                                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-1 px-3 rounded-lg text-xs shadow-sm transition duration-200">Accept</button>
                                            </form>
                                            <form asp-controller="Friends" asp-action="UpdateRequestStatus" method="post" class="inline">
                                                <input type="hidden" name="requestId" value="@request.Id" />
                                                <input type="hidden" name="action" value="decline" />
                                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-1 px-3 rounded-lg text-xs shadow-sm transition duration-200">Decline</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                    }
                    </div>
            }
            else
            {
                    <div class="bg-blue-50 text-blue-700 p-4 rounded-lg text-sm">
                        No received friend requests.
                    </div>
            }
        </div>

        <!-- Sent Requests Column -->
        <div>
            <h3 class="text-xl font-semibold text-gray-700 mb-4">Sent Requests</h3>
            @if (Model.SentRequests.Any())
            {
                    <div class="space-y-4">
                    @foreach (var request in Model.SentRequests)
                    {
                                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                                    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                                        <div class="flex items-center flex-grow">
                                    @if (!string.IsNullOrEmpty(request.Receiver.ProfilePicture))
                                    {
                                                    <img src="@request.Receiver.ProfilePicture" alt="Profile Picture" class="rounded-full w-10 h-10 object-cover mr-3 flex-shrink-0">
                                    }
                                    else
                                    {
                                                    <!-- Default SVG User Icon -->
                                                    <div class="rounded-full bg-gray-200 w-10 h-10 flex items-center justify-center mr-3 flex-shrink-0">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                        </svg>
                                                    </div>
                                    }
                                            <div class="overflow-hidden">
                                                <h5 class="text-base font-semibold text-gray-800 truncate">@request.Receiver.FirstName @request.Receiver.LastName</h5>
                                                <small class="text-sm text-gray-500 truncate block">@request.Receiver.Email</small>
                                                <p class="text-xs text-gray-400 mt-0.5">Pending</p>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0 mt-2 sm:mt-0">
                                            <form asp-controller="Friends" asp-action="UpdateRequestStatus" method="post">
                                                <input type="hidden" name="requestId" value="@request.Id" />
                                                <input type="hidden" name="action" value="cancel" />
                                                <button type="submit" class="inline-flex items-center px-2 py-2 border border-transparent text-xs font-medium rounded-lg text-red-700 bg-red-100 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">Cancel</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                    }
                    </div>
            }
            else
            {
                     <div class="bg-blue-50 text-blue-700 p-4 rounded-lg text-sm">
                        No sent friend requests.
                    </div>
            }
        </div>
    </div>
</div>
